# Copy to .env.local for development, or set in the deploy environment.

# Canonical origin. Drives canonical URLs, Open Graph URLs, the sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://kairosmarcom.com

# Shows editorial status banners on case studies and legal pages.
# Set to "true" on staging. MUST be unset or "false" in production.
NEXT_PUBLIC_SHOW_CONTENT_FLAGS=false

# --- Contact form delivery -------------------------------------------------
# At least one transport must be configured or /api/contact returns 503 and the
# form shows the direct email/WhatsApp fallback. It never reports a false success.

# Option A — email via Resend (single authenticated POST, no SDK).
RESEND_API_KEY=
CONTACT_TO=hello@kairosmarcom.com
CONTACT_FROM=Kairos site <site@kairosmarcom.com>

# Option B — POST the enquiry JSON to a CRM, Zapier hook or internal endpoint.
# Tried after Resend, so it can also act as a backup.
CONTACT_WEBHOOK_URL=
